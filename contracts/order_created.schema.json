{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bk-fintech.edu.vn/schemas/order_created.v1.json",
  "title": "OrderCreated",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "event_time",
    "source",
    "order_id",
    "customer_id",
    "items",
    "total_amount",
    "currency"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "const": "OrderCreated"
    },
    "event_version": {
      "type": "integer",
      "const": 1
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["product_id", "quantity", "unit_price"],
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "total_amount": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "const": "VND"
    }
  }
}
