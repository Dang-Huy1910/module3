{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bk-fintech.edu.vn/schemas/product_viewed.v1.json",
  "title": "ProductViewed",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "event_time",
    "source",
    "customer_id",
    "session_id",
    "product_id"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "const": "ProductViewed"
    },
    "event_version": {
      "type": "integer",
      "const": 1
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "customer_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "device_type": {
      "type": "string",
      "enum": ["mobile", "desktop", "tablet"]
    }
  }
}
