# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:29092
KAFKA_ORDER_TOPIC=order-events
KAFKA_ACTIVITY_TOPIC=customer-activity-events

# SeaweedFS / S3 Object Storage Configuration
S3_ENDPOINT_URL=http://object-storage:8333
AWS_ACCESS_KEY_ID=anykey
AWS_SECRET_ACCESS_KEY=anysecret
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=ecommerce-raw

# ClickHouse Configuration
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=analytics-dev

# App & Environment
APP_ENV=development
LOG_LEVEL=INFO
